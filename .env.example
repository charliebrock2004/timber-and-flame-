# ─────────────────────────────────────────────────────────────
# Timber & Flame — environment variables
# Copy to .env for local development. In production set these in
# Vercel → Project → Settings → Environment Variables.
# Never commit real values.
# ─────────────────────────────────────────────────────────────

# ── REQUIRED ─────────────────────────────────────────────────
# Postgres connection string. On Vercel use the POOLED URL (Neon: the one
# with "-pooler" in the host) and keep ?sslmode=require.
DATABASE_URL=

# Public site URL, no trailing slash, e.g. https://www.timberandflame.co.uk
# Used for canonical links, sitemap, Open Graph and links in emails.
# (If unset on Vercel, the production *.vercel.app domain is used.)
NEXT_PUBLIC_SITE_URL=

# Admin login (/admin). There is no default password.
ADMIN_EMAIL=
# Generate with:  npm run admin:hash -- "a long password"
ADMIN_PASSWORD_HASH=
# 32+ random characters (admin:hash prints a suggestion)
SESSION_SECRET=

# ── ORDER EMAILS (required for emails; orders still save without) ──
# Gmail: Google Account → Security → 2-Step Verification ON →
#        App passwords → create one for "Timber & Flame website".
GMAIL_USER=timberflame84@gmail.com
GMAIL_APP_PASSWORD=

# ── OPTIONAL ─────────────────────────────────────────────────
# Unpooled/direct URL, used only by `npm run db:migrate` / `db:seed`.
DIRECT_URL=
# Where new-order emails go. Default: business email in /admin/settings.
ORDER_NOTIFICATION_EMAIL=
# "From" header. Default: "Timber & Flame Firewood" <GMAIL_USER>
ORDER_EMAIL_FROM=
# Checkout attempts per IP per 10 minutes (default 10).
CHECKOUT_RATE_LIMIT=

# Alternative email transports — use INSTEAD of Gmail, not as well.
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASS=
# RESEND_API_KEY=

# ── DO NOT SET (online payment is not live) ──────────────────
# Setting BOTH of these would switch on dormant Stripe card payments.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
